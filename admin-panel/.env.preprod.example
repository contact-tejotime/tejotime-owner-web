# Preprod Railway crib sheet.
# BACKEND_API_BASE_URL is runtime; NEXT_PUBLIC_FRONTEND_URL is a Build Variable.
# Must point at api-preprod — pointing at production API disables/enables prod stores.
BACKEND_API_BASE_URL=https://api-preprod.tejotime.com/api/v1
NEXT_PUBLIC_FRONTEND_URL=https://preprod.tejotime.com
