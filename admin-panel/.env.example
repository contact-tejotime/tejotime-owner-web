# ---- Server-side only (used by the server route handlers / server components) ----
# Base URL of the Express backend's versioned API. Admins authenticate via mobile+OTP; the
# backend returns an admin JWT that is stored in an httpOnly cookie and forwarded as a Bearer
# token on server→backend calls (no shared secret needed).
BACKEND_API_BASE_URL=http://localhost:8080/api/v1

# ---- Public (browser) ----
# Origin of the frontend microsite, used for the preview link/iframe (www.tejotime.com/<phone>).
NEXT_PUBLIC_FRONTEND_URL=https://www.tejotime.com
