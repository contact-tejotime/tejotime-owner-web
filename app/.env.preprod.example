# Preprod owner-app build crib sheet.
EXPO_PUBLIC_ENV=preprod
EXPO_PUBLIC_API_BASE_URL=https://api-preprod.tejotime.com/api/v1
EXPO_PUBLIC_SOCKET_URL=https://api-preprod.tejotime.com
EXPO_PUBLIC_WEB_URL=https://preprod.tejotime.com

# PayPal card reader (docs/card-payments-paypal.md). Developer mode is OFF on preprod since
# 2026-10-19: charges are real, through the signed-in PayPal account.
EXPO_PUBLIC_PAYPAL_CLIENT_ID_IOS=66468793-91b4-49b1-9ba5-146f5654722c
EXPO_PUBLIC_PAYPAL_CLIENT_ID_ANDROID=a1bbe334-eeaa-482b-8327-532025953b40
EXPO_PUBLIC_PAYPAL_REDIRECT_URL=tejotime-paypal://login.callback
EXPO_PUBLIC_PAYPAL_DEV_MODE=false
