# Local Expo — copy to `.env.local` (or set via Expo env).
#
# ANDROID EMULATOR: run `npm run reverse` first (or use `npm run android`, which does it).
# Inside an emulator `localhost` is the emulator itself, so without that mapping every request
# fails with "Failed to connect to localhost/127.0.0.1:8080". Mapping the ports beats hardcoding
# 10.0.2.2, which would then break the iOS simulator and web.
#
# PHYSICAL DEVICE: replace `localhost` with this machine's LAN IP (`ipconfig getifaddr en0`),
# and put the phone on the same Wi-Fi.
EXPO_PUBLIC_ENV=local
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
EXPO_PUBLIC_SOCKET_URL=http://localhost:8080
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# PayPal card reader (docs/card-payments-paypal.md). Developer mode: no real money.
EXPO_PUBLIC_PAYPAL_CLIENT_ID_IOS=66468793-91b4-49b1-9ba5-146f5654722c
EXPO_PUBLIC_PAYPAL_CLIENT_ID_ANDROID=a1bbe334-eeaa-482b-8327-532025953b40
EXPO_PUBLIC_PAYPAL_REDIRECT_URL=tejotime-paypal://login.callback
EXPO_PUBLIC_PAYPAL_DEV_MODE=true
