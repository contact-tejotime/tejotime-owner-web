# Local laptop — copy to `.env.local`.
# Nothing is required: BACKEND_API_BASE_URL falls back to this exact value, so
# `npm run dev:backend` + `npm run dev:owner` works with no .env.local at all.
BACKEND_API_BASE_URL=http://localhost:8080/api/v1
# Browser → backend, for live queue/appointment updates (owner /owner socket). Unset = the pages poll every 15s instead.
NEXT_PUBLIC_SOCKET_URL=http://localhost:8080
# Customer microsite — Appearance live preview iframes this host.
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
