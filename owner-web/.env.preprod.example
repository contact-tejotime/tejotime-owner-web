# Preprod Railway crib sheet. Root Directory = owner-web, domain business-preprod.tejotime.com.
# BACKEND_API_BASE_URL is runtime only — deliberately NOT a Dockerfile ARG, so the browser
# never learns the API address; every call goes through this app's own /api/* handlers.
# Must point at api-preprod: the owner token it mints writes to whichever API this names.
BACKEND_API_BASE_URL=https://api-preprod.tejotime.com/api/v1
# Build Variable (baked in, needs a redeploy to change). Not wired up yet.
# NEXT_PUBLIC_SOCKET_URL=https://api-preprod.tejotime.com
# Build Variable — customer microsite for Appearance live preview / store links.
NEXT_PUBLIC_FRONTEND_URL=https://preprod.tejotime.com
