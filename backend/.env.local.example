# Local laptop — copy to `.env` and fill secrets.
# Pattern: LOCAL hosts (localhost) + PREPROD database (public proxy).
# Do NOT use production DATABASE_URL (sakura) or private railway.internal hosts.
# Full catalog: see `.env.example`. For preprod/prod crib sheets see `.env.preprod` / `.env.prod`.

NODE_ENV=development
PORT=8080
APP_BASE_URL=http://localhost:8080
PUBLIC_WEB_URL=http://localhost:3000
LOG_LEVEL=info
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,https://preprod.tejotime.com,https://admin-preprod.tejotime.com

# Preprod PUBLIC proxy (*.proxy.rlwy.net) — not production, not private host.
DATABASE_URL=postgresql://postgres:PASSWORD@PREPROD_PUBLIC_HOST:PORT/railway
DATABASE_POOL_MAX=10

S3_ENDPOINT=https://t3.storageapi.dev
S3_REGION=auto
S3_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
S3_BUCKET=your-bucket-name
S3_FORCE_PATH_STYLE=false
S3_UPLOAD_URL_TTL=600
S3_DOWNLOAD_URL_TTL=3600

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
CUSTOMER_TOKEN_SECRET=change-me-customer
TICKET_URL_HMAC_SECRET=change-me-ticket
PASSWORD_PEPPER=change-me-pepper
JWT_ADMIN_TTL=43200

FREE_PLAN_CUSTOMER_LIMIT=2
ETA_NOTIFY_MINUTES=15
TICKET_ABANDON_HOURS=4
BOOKING_SLOT_MINUTES=30

OTP_ENABLED=false
PAYMENTS_ENABLED=false
SMS_ENABLED=false
EMAIL_ENABLED=false
WHATSAPP_ENABLED=false

WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
WHATSAPP_TEMPLATE_ETA_15=eta_15

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_TEST_TO=

# ---- Customer microsite chatbot (docs/customer-chatbot-v1.md) ----
# Off by default. With CHATBOT_ENABLED=true and CHATBOT_PROVIDER=none the bot answers from the
# store's FAQs and public facts only — no external call, no key needed.
# Optional free upgrade: CHATBOT_PROVIDER=gemini (Google AI Studio key) or groq (Groq key).
# openai is accepted but is a paid key and never the default. CHATBOT_MODEL blank = provider's
# free-tier default (gemini-2.5-flash-lite / llama-3.1-8b-instant / gpt-4o-mini).
CHATBOT_ENABLED=false
CHATBOT_PROVIDER=none
CHATBOT_API_KEY=
CHATBOT_MODEL=
CHATBOT_MAX_HISTORY=8
CHATBOT_MAX_MESSAGE_CHARS=500
CHATBOT_TIMEOUT_MS=8000

OTP_LENGTH=4
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_PEPPER=change-me-otp
