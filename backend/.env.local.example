# Local laptop — copy to `.env` and fill secrets.
# Pattern: LOCAL hosts (localhost) + PREPROD database (public proxy).
# Do NOT use production DATABASE_URL (sakura) or private railway.internal hosts.
# Full catalog: see `.env.example`. For preprod/prod crib sheets see `.env.preprod` / `.env.prod`.

NODE_ENV=development
PORT=8080
APP_BASE_URL=http://localhost:8080
PUBLIC_WEB_URL=http://localhost:3000
LOG_LEVEL=info
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,https://preprod.tejotime.com,https://admin-preprod.tejotime.com

# Preprod PUBLIC proxy (*.proxy.rlwy.net) — not production, not private host.
DATABASE_URL=postgresql://postgres:PASSWORD@PREPROD_PUBLIC_HOST:PORT/railway
DATABASE_POOL_MAX=10

S3_ENDPOINT=https://t3.storageapi.dev
S3_REGION=auto
S3_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
S3_BUCKET=your-bucket-name
S3_FORCE_PATH_STYLE=false
S3_UPLOAD_URL_TTL=600
S3_DOWNLOAD_URL_TTL=3600

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
CUSTOMER_TOKEN_SECRET=change-me-customer
TICKET_URL_HMAC_SECRET=change-me-ticket
PASSWORD_PEPPER=change-me-pepper
JWT_ADMIN_TTL=43200

TICKET_ABANDON_HOURS=4
BOOKING_SLOT_MINUTES=30

OTP_ENABLED=false
PAYMENTS_ENABLED=false
SMS_ENABLED=false
EMAIL_ENABLED=false

# SMS_ENABLED=true + TWILIO_* sends the three customer texts (docs/sms-opt-in-a2p.md)

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Messaging Service the A2P campaign is linked to (MG...). When set, texts go through it and
# TWILIO_FROM is unused. The campaign number must be in its Sender Pool.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=
TWILIO_TEST_TO=
# Calling codes that may receive a text, comma-separated (e.g. 1,91). Blank/unset = 1 (US only).
TWILIO_ALLOWED_COUNTRY_CODES=1

# ---- WhatsApp (Meta Cloud API) for +91 customers — docs/whatsapp-india.md ----
# Works like SMS_ENABLED: false = still recorded as a whatsapp notification, never sent to Meta.
WHATSAPP_ENABLED=false
# System user permanent token (whatsapp_business_messaging) + the sender's phone number ID.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
# Customers with these calling codes get WhatsApp instead of SMS. Blank/unset = 91.
WHATSAPP_COUNTRY_CODES=91
# Set to your own +91 number for any local run — backend/.env points at the live preprod DB.
WHATSAPP_TEST_TO=
# Meta app secret (signs webhook POSTs) + the verify token you type into Meta's webhook setup.
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ---- Customer microsite chatbot (docs/customer-chatbot-v1.md) ----
# Off by default. With CHATBOT_ENABLED=true and CHATBOT_PROVIDER=none the bot answers from the
# store's FAQs and public facts only — no external call, no key needed.
# Optional free upgrade: CHATBOT_PROVIDER=gemini (Google AI Studio key) or groq (Groq key).
# openai is accepted but is a paid key and never the default. CHATBOT_MODEL blank = provider's
# free-tier default (gemini-2.5-flash-lite / llama-3.1-8b-instant / gpt-4o-mini).
CHATBOT_ENABLED=false
CHATBOT_PROVIDER=none
CHATBOT_API_KEY=
CHATBOT_MODEL=
CHATBOT_MAX_HISTORY=8
CHATBOT_MAX_MESSAGE_CHARS=500
CHATBOT_TIMEOUT_MS=8000

# ---- Admin store autofill from a link (docs/store-autofill-from-link.md) ----
# Off by default. Needs a Groq key (free tier is fine). Server-side only.
AUTOFILL_ENABLED=false
AUTOFILL_API_KEY=
AUTOFILL_MODEL=openai/gpt-oss-120b
AUTOFILL_TIMEOUT_MS=20000

OTP_LENGTH=4
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_PEPPER=change-me-otp
