# Full variable catalog for local development.
# Also see: .env.local.example, .env.preprod.example, .env.prod.example
# Copy to `.env` or `.env.local` and fill secrets — never commit real values.
#
# ---- Core ----
NODE_ENV=development
PORT=8080
APP_BASE_URL=http://localhost:8080
PUBLIC_WEB_URL=http://localhost:3000
LOG_LEVEL=info
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:8081

# ---- Postgres ----
# Used by the runtime connection pool AND the migration/seed CLI.
# On Railway: use the PRIVATE url (postgres.railway.internal) for the deployed
# service, and the PUBLIC proxy url (*.proxy.rlwy.net) for local tooling.
# TLS is derived from the host automatically — see src/db/ssl.ts.
# PREPROD and PRODUCTION must use DIFFERENT Postgres instances.
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/railway
DATABASE_POOL_MAX=10

# ---- Object storage (Railway Buckets, S3-compatible) ----
# From the bucket's Credentials tab. The bucket is private; images are served
# via GET /media/<key>, which redirects to a short-lived signed URL.
S3_ENDPOINT=https://t3.storageapi.dev
S3_REGION=auto
S3_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
S3_BUCKET=your-bucket-name
# Set true only if the bucket's Credentials tab says it needs path-style URLs.
S3_FORCE_PATH_STYLE=false
S3_UPLOAD_URL_TTL=600
S3_DOWNLOAD_URL_TTL=3600

# ---- Auth (generate strong random values) ----
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
CUSTOMER_TOKEN_SECRET=change-me-customer
TICKET_URL_HMAC_SECRET=change-me-ticket
PASSWORD_PEPPER=change-me-pepper
# Admin-panel access-token lifetime in seconds (default 12h). Admin JWTs are signed with JWT_ACCESS_SECRET.
JWT_ADMIN_TTL=43200
# Admin-panel login password is stored in the DB (admins.password_hash), peppered
# with PASSWORD_PEPPER like owner logins. `npm run migrate` fills any admin row
# still missing a hash with password `admin456`. No env hash needed.

# ---- Plan / feature config ----
FREE_PLAN_CUSTOMER_LIMIT=2
ETA_NOTIFY_MINUTES=15
TICKET_ABANDON_HOURS=4
BOOKING_SLOT_MINUTES=30

# ---- Feature flags for deferred external integrations ----
OTP_ENABLED=false
PAYMENTS_ENABLED=false
SMS_ENABLED=false
EMAIL_ENABLED=false
WHATSAPP_ENABLED=false

# ---- WhatsApp (used when WHATSAPP_ENABLED=true) ----
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
WHATSAPP_TEMPLATE_ETA_15=eta_15

# ---- Twilio (temporary SMS test for ETA-15 alerts) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_TEST_TO=

# ---- Customer microsite chatbot (docs/customer-chatbot-v1.md) ----
# Off by default. With CHATBOT_ENABLED=true and CHATBOT_PROVIDER=none the bot answers from the
# store's FAQs and public facts only — no external call, no key needed.
# Optional free upgrade: CHATBOT_PROVIDER=gemini (Google AI Studio key) or groq (Groq key).
# openai is accepted but is a paid key and never the default. CHATBOT_MODEL blank = provider's
# free-tier default (gemini-2.5-flash-lite / llama-3.1-8b-instant / gpt-4o-mini).
CHATBOT_ENABLED=false
CHATBOT_PROVIDER=none
CHATBOT_API_KEY=
CHATBOT_MODEL=
CHATBOT_MAX_HISTORY=8
CHATBOT_MAX_MESSAGE_CHARS=500
CHATBOT_TIMEOUT_MS=8000

# ---- OTP (used when OTP_ENABLED=true) ----
OTP_LENGTH=4
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_PEPPER=change-me-otp
