# Production Railway environment crib sheet.
# Set these on the production API service in Railway (do not commit real secrets).

NODE_ENV=production
PORT=8080
APP_BASE_URL=https://api.tejotime.com
PUBLIC_WEB_URL=https://www.tejotime.com
LOG_LEVEL=info
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
CORS_ALLOWED_ORIGINS=https://www.tejotime.com,https://admin.tejotime.com,https://business.tejotime.com

# PRODUCTION-ONLY Postgres private URL. Never share with preprod.
DATABASE_URL=postgresql://postgres:PASSWORD@PROD_HOST:5432/railway
DATABASE_POOL_MAX=10

S3_ENDPOINT=https://t3.storageapi.dev
S3_REGION=auto
S3_ACCESS_KEY_ID=YOUR_PROD_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_PROD_SECRET_ACCESS_KEY
S3_BUCKET=your-prod-bucket-name
S3_FORCE_PATH_STYLE=false
S3_UPLOAD_URL_TTL=600
S3_DOWNLOAD_URL_TTL=3600

JWT_ACCESS_SECRET=change-me-prod-access
JWT_REFRESH_SECRET=change-me-prod-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
CUSTOMER_TOKEN_SECRET=change-me-prod-customer
TICKET_URL_HMAC_SECRET=change-me-prod-ticket
PASSWORD_PEPPER=change-me-prod-pepper
JWT_ADMIN_TTL=43200

FREE_PLAN_CUSTOMER_LIMIT=2
ETA_NOTIFY_MINUTES=15
TICKET_ABANDON_HOURS=4
BOOKING_SLOT_MINUTES=30

OTP_ENABLED=false
PAYMENTS_ENABLED=false
SMS_ENABLED=false
EMAIL_ENABLED=false
WHATSAPP_ENABLED=false

WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
WHATSAPP_TEMPLATE_ETA_15=eta_15

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_TEST_TO=

OTP_LENGTH=4
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_PEPPER=change-me-prod-otp
